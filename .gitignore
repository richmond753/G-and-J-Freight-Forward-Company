# Dependencies
node_modules/

# Environment / secrets — never commit these
.env
.env.*
!.env.example

# Runtime data (leads CRM) — keep folder, ignore contents except placeholder
backend/data/*
!backend/data/.gitkeep

# Uploaded customer documents
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
