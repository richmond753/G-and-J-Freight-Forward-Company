# ─────────────────────────────────────────────
#  G and J Freight Services – Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# CORS – comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,https://g-and-j-freight-forward-company.onrender.com,https://gandjfreightservices.com

# Email (SMTP) – used by Nodemailer to send contact-form submissions
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# Optional: force TLS certificate verification on/off.
# Leave unset to auto-relax in development (helps when local antivirus/proxy
# injects a self-signed certificate) and stay strict in production.
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# Where contact-form emails are delivered
CONTACT_RECEIVER=info@gandjfreightservices.com

# Staff CRM (/admin.html) – required to unlock lead inbox API
ADMIN_TOKEN=change-me-to-a-long-random-secret

# Driver / haulage status updates (/haulage.html)
# If unset, ADMIN_TOKEN is accepted as the driver PIN
# HAULAGE_PIN=change-me-driver-pin

# Public site URL (Paystack payment callback)
PUBLIC_SITE_URL=https://g-and-j-freight-forward-company.onrender.com

# Payments — MoMo (comma-separated; defaults to all public company lines)
MOMO_NUMBERS=233244333374,233245839831,233207499123,233570793888
MOMO_ACCOUNT_NAME=G and J Freight Services

# Bank transfer (shown on /pay.html when all three are set)
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
# BANK_BRANCH=Tema

# Paystack (MoMo + card online). Required for live checkout on /pay.html
# PAYSTACK_PUBLIC_KEY=pk_test_xxx
# PAYSTACK_SECRET_KEY=sk_test_xxx

# Optional live ocean tracking (ShipsGo free trial / paid)
# Sign up at https://shipsgo.com → dashboard → API auth code
# SHIPSGO_AUTH_CODE=

# Optional Maersk Consumer-Key (from Maersk developer portal)
# MAERSK_CONSUMER_KEY=

# Rate-limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
